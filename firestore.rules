rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Mirrors what public/js/firebase.js writes: { title, date, color }.
    function isValidEvent(data) {
      return data.keys().hasOnly(['title', 'date', 'color'])
        && data.keys().hasAll(['title', 'date', 'color'])
        && data.title is string && data.title.size() <= 100
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.color in ['cc-cream', 'cc-sage', 'cc-sky', 'cc-rose',
                          'cc-lavender', 'cc-amber', 'cc-slate', 'cc-mint'];
    }

    match /users/{userId}/events/{eventId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidEvent(request.resource.data);
    }
  }
}
