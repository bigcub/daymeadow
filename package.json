{
  "name": "daymeadow",
  "version": "1.0.0",
  "private": true,
  "description": "Count down to the days that matter.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "firebase emulators:start --project demo-daymeadow",
    "dev:no-java": "firebase emulators:start --project demo-daymeadow --only hosting,auth",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run test/unit",
    "test:rules": "firebase emulators:exec --project demo-daymeadow --only firestore \"vitest run test/rules\"",
    "check": "npm run lint && npm run format:check && npm test",
    "deploy:hosting": "firebase deploy --only hosting --project daymeadow-55cc0",
    "deploy:rules": "firebase deploy --only firestore:rules --project daymeadow-55cc0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "eslint": "^10.13.0",
    "firebase": "^13.1.0",
    "firebase-tools": "^15.34.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "vitest": "^5.0.5"
  }
}
